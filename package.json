{
  "name": "furescue",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:mobile": "npm run start --workspace apps/mobile",
    "build:web": "npm run build --workspace apps/web",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:seed-report": "tsx scripts/seed-pending-report.ts",
    "db:seed-adoption": "tsx scripts/seed-adoption-application.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:apply-init": "node scripts/apply-supabase-sql.mjs",
    "db:apply-migration": "node scripts/apply-migration.mjs",
    "db:create-admin": "tsx scripts/create-admin.ts",
    "db:verify": "tsx scripts/verify-db.ts",
    "typecheck:core": "npm run typecheck --workspace @furescue/core",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15"
  }
}
