# =============================================================================
# FurRescue — Environment Template
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME="FurRescue"
APP_URL="http://localhost:3000"
API_BASE_URL="http://localhost:3000/api"

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
JWT_SECRET="replace-with-a-strong-random-secret"
JWT_EXPIRES_IN="7d"

# Custom scheme the Expo app registers (app.json → expo.scheme). Google OAuth
# started from the mobile app returns through this deep link.
MOBILE_APP_SCHEME="mobile"

# -----------------------------------------------------------------------------
# Email verification (OTP) + SMTP
# Manual signups receive a 6-digit code. In development, when SMTP_HOST is
# empty, the code is printed to the server console instead of being emailed.
# Gmail example: SMTP_HOST="smtp.gmail.com", SMTP_PORT=587, SMTP_SECURE="false",
# SMTP_USER="you@gmail.com", SMTP_PASS="<16-character Google app password>".
# Port 465 providers need SMTP_SECURE="true".
# -----------------------------------------------------------------------------
EMAIL_VERIFICATION_TTL_MINUTES=10
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="FuRescue <no-reply@furescue.app>"

# -----------------------------------------------------------------------------
# Supabase — public (safe to expose to the browser / Expo client)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_<key>"

# -----------------------------------------------------------------------------
# Supabase — server only (never expose to clients)
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# -----------------------------------------------------------------------------
# Database — Prisma
# DATABASE_URL: pooled connection used by the running application.
# DIRECT_URL:   direct/session connection used for migrations and seeding.
# URL-encode special characters in the password.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true"

# -----------------------------------------------------------------------------
# Uploads / storage
# -----------------------------------------------------------------------------
SUPABASE_STORAGE_BUCKET="furescue-media"
MAX_IMAGE_SIZE_MB=5
MAX_VIDEO_DURATION_SECONDS=30
