# Public URL of the Next.js app that serves the API.
# The phone must be able to reach it directly.
#
# Local Wi-Fi (device and computer on the same network):
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
# Deployed backend:
#   EXPO_PUBLIC_API_URL=https://furescue.example.com
#
# Leave this unset to auto-detect the Metro LAN host in development.
EXPO_PUBLIC_API_URL=

# Set to "false" to use the in-memory placeholder data instead of the API.
EXPO_PUBLIC_RESCUER_API=true
